{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nextjs-ai-cost-guard",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public", "enable_request_signal"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": false },
  "workers_dev": false,
  "routes": [{ "pattern": "ai-cost-guard.devya.dev", "custom_domain": true }],
  // Secrets (wrangler secret put): UPSTASH_REDIS_REST_URL, UPSTASH_REDIS_REST_TOKEN
  "vars": {
    "GUARD_PREFIX": "demo"
  }
}
