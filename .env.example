# Upstash Redis (console.upstash.com → your database → REST API)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: a real model through the Vercel AI Gateway. Leave empty to run the
# built-in mock model, which streams a canned answer and reports token usage,
# so every guard works without an API key.
AI_GATEWAY_API_KEY=
PRIMARY_MODEL=anthropic/claude-sonnet-5.5
FALLBACK_MODEL=anthropic/claude-haiku-5.5

# Key prefix, so one database can host several apps or test runs.
GUARD_PREFIX=aiguard
